% Generated by hand for the ACQ-RUN3 public contract.
\name{acquisition_worker_health}
\alias{acquisition_worker_health_configure}
\alias{acquisition_worker_health_heartbeat}
\alias{acquisition_worker_health_start}
\alias{acquisition_worker_health_status}
\alias{acquisition_worker_health_stop}
\title{Persisted independent acquisition worker health}
\description{
  Records and reads lifecycle heartbeats for the bounded independent
  acquisition worker pool. Health is separate from queue attempts and does not
  claim completed bytes or files.
}
\usage{
acquisition_worker_health_configure(catalog, worker_ids)
acquisition_worker_health_start(catalog, worker_id, expected = TRUE,
  now = Sys.time())
acquisition_worker_health_heartbeat(catalog, worker_id,
  state = c("idle", "busy"), now = Sys.time())
acquisition_worker_health_stop(catalog, worker_id,
  state = c("stopped", "error"), error_category = NULL,
  error_message = NULL, now = Sys.time())
acquisition_worker_health_status(catalog, expected_workers = NULL,
  freshness_seconds = 30, now = Sys.time())
}
\arguments{
  \item{catalog}{An acquisition catalog from \code{acquisition_catalog_open()}.}
  \item{worker_ids}{One to 32 trusted expected worker identities.}
  \item{worker_id}{A stable worker process identity.}
  \item{expected}{Whether the worker belongs to the expected pool.}
  \item{state}{Lifecycle state to record.}
  \item{error_category}{Optional bounded error category.}
  \item{error_message}{Optional diagnostic text; credential-shaped values are redacted.}
  \item{expected_workers}{Optional one to 32 trusted expected identities.}
  \item{freshness_seconds}{Maximum age for an idle or busy heartbeat.}
  \item{now}{Observation time, primarily for deterministic tests.}
}
\value{
  The mutating functions return a list describing the recorded identity and
  state. \code{acquisition_worker_health_status()} returns a list with a
  bounded \code{workers} data frame, named \code{counts}, and \code{as_of}.
  States include \code{idle}, \code{busy}, \code{stopped}, \code{error},
  derived \code{stale}, and \code{unknown}.
}
\seealso{\link{acquisition_worker_run}, \link{acquisition_catalog_open}}
